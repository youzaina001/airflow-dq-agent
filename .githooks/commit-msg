#!/bin/sh
# Reject multi-line messages and AI-agent attribution trailers.
set -eu

msg=$(sed '/^#/d;/^[[:space:]]*$/d' "$1")
if [ -z "$msg" ]; then
  echo "commit-msg: empty message" >&2
  exit 1
fi
n=$(printf '%s\n' "$msg" | wc -l)
if [ "$n" -ne 1 ]; then
  echo "commit-msg: one line only (got $n)" >&2
  exit 1
fi
if printf '%s\n' "$msg" | grep -qiE \
  'co-authored-by:|generated with|generated by|copilot suggested|noreply@anthropic'; then
  echo "commit-msg: no AI attribution" >&2
  exit 1
fi
exit 0
