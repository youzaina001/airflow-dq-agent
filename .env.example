# --- Warehouse (synthetic e-commerce + clinical-trial-ish model) ---
WAREHOUSE_DSN=postgresql+psycopg://dq:dq@localhost:5433/warehouse

# --- LLM ---
# stub   = deterministic policy mapper (CI default, no network)
# replay = replay a recorded trace fixture
# live   = OpenAI-compatible API via pydantic-ai
LLM_MODE=stub
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Used only when LLM_MODE=replay
REPLAY_TRACE_PATH=evals/fixtures/traces/replay-proposal.json

# --- Autonomy ---
# off  = shadow mode (default): propose + eval, never mutate
# hitl = ApprovalOperator must approve before apply task runs
APPLY_MODE=off
APPLY_ADMISSION_TTL_HOURS=24
# One comma-separated identity source drives both ApprovalOperator assignment and
# audited response validation. Required for APPLY_MODE=hitl.
HITL_APPROVER_IDS=airflow

# --- Airflow connections (docker-compose injects these) ---
AIRFLOW_CONN_PYDANTICAI_DEFAULT=
AIRFLOW_CONN_WAREHOUSE_POSTGRES=postgresql://dq:dq@warehouse:5432/warehouse
AIRFLOW_UID=50000

# --- Optional MCP catalog ---
CATALOG_MCP_HOST=0.0.0.0
CATALOG_MCP_PORT=8000

# --- Traces ---
TRACES_DIR=traces
TRACE_POSTGRES=false
# Production uses distinct least-privilege login DSNs for these three roles.
# Local Compose defaults them to the synthetic warehouse bootstrap user.
READ_DSN=
AUDIT_DSN=
APPLY_DSN=
